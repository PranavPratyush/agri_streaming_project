      "title": "Field Composite Crop Stress Index (CSI)",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {"expr": "agri_risk_composite_stress_index", "legendFormat": "Field: {{field_id}}"}
