    {
      "id": 2,
      "title": "Candidate Crop Stress Alerts by Severity",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {"expr": "sum by (severity, risk_type) (rate(agri_risk_candidate_alerts_total[1m]))", "legendFormat": "{{severity}} - {{risk_type}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "cps", "color": {"mode": "palette-classic"}}}
    },
    {
      "id": 3,
      "title": "Investigator Agent Tool Invocations",
      "type": "barchart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by (tool_name) (agri_investigator_tool_calls_total)", "legendFormat": "{{tool_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}}
    },
    {
      "id": 4,
      "title": "Agent Investigation Latency (p95 Seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, model) (rate(agri_investigator_duration_seconds_bucket[1m])))", "legendFormat": "p95: {{model}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line"}}}
    },
    {
      "id": 5,
      "title": "Rule-Engine Fallback Rate (Triage Fallback)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
