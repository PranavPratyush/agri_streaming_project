      "title": "Consumer Group Consumption Rate (Messages/sec)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum by (consumer_group, topic) (rate(agri_kafka_messages_consumed_total[1m]))", "legendFormat": "{{consumer_group}} [{{topic}}]"}
      ],
      "fieldConfig": {"defaults": {"unit": "cps", "custom": {"drawStyle": "line"}}}
    },
    {
      "id": 3,
      "title": "Consumer Group Lag (Records Backlog)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by (consumer_group, topic) (agri_kafka_consumer_lag_records)", "legendFormat": "{{consumer_group}} - {{topic}}"}
