  "panels": [
    {
      "id": 1,
      "title": "Spark Micro-Batch Input vs Emitted Rows (Rows/sec)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum by (query_name) (rate(agri_spark_input_rows_total[1m]))", "legendFormat": "Input: {{query_name}}"},
        {"expr": "sum by (query_name) (rate(agri_spark_processed_rows_total[1m]))", "legendFormat": "Processed: {{query_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "cps", "custom": {"drawStyle": "line"}}}
    },
    {
      "id": 2,
      "title": "Micro-Batch Execution Duration (p50 & p95 Seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, query_name) (rate(agri_spark_batch_duration_seconds_bucket[1m])))", "legendFormat": "p50 Duration: {{query_name}}"},
        {"expr": "histogram_quantile(0.95, sum by (le, query_name) (rate(agri_spark_batch_duration_seconds_bucket[1m])))", "legendFormat": "p95 Duration: {{query_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line"}}}
    },
    {
      "id": 3,
      "title": "Event-Time Watermark Lag (Seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "time() - agri_spark_watermark_timestamp_seconds", "legendFormat": "Watermark Lag: {{query_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 600}, {"color": "red", "value": 1200}]}}}
    },
    {
      "id": 4,
      "title": "Out-of-Order Rows Dropped by Watermark",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (query_name) (rate(agri_spark_late_rows_dropped_total[1m]))", "legendFormat": "Dropped Rows: {{query_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "cps", "color": {"mode": "palette-classic"}}}
    },
    {
      "id": 5,
      "title": "Checkpoint Commits Success vs Failure",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {"expr": "sum by (status) (agri_spark_checkpoint_commits_total)", "legendFormat": "{{status}}"}
      ],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}}
    }
  ],
