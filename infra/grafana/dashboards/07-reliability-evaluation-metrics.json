{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "TimescaleDB Connection Pool Status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "targets": [
        {"expr": "agri_db_pool_connections", "legendFormat": "{{state}} connections"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line"}}}
    },
    {
      "id": 2,
      "title": "Database Persistence Operations (Inserted vs Deduplicated)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
      "targets": [
        {"expr": "sum by (table, operation) (rate(agri_db_upsert_operations_total[1m]))", "legendFormat": "{{table}} - {{operation}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "cps", "color": {"mode": "palette-classic"}}}
    },
    {
      "id": 3,
      "title": "Database Analytical Query Latency (p95 Seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, query_name) (rate(agri_db_query_duration_seconds_bucket[1m])))", "legendFormat": "p95: {{query_name}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line"}}}
    },
    {
      "id": 4,
      "title": "Advisory Notification Deliveries & Deduplications",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (channel, status) (rate(agri_notification_attempts_total[1m]))", "legendFormat": "{{channel}} - {{status}}"},
        {"expr": "sum by (channel) (rate(agri_notification_deduplications_total[1m]))", "legendFormat": "{{channel}} - deduped"}
      ],
      "fieldConfig": {"defaults": {"unit": "cps", "color": {"mode": "palette-classic"}}}
    },
    {
      "id": 5,
      "title": "Human Feedback & Verification Responses",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {"expr": "sum by (action_taken) (agri_human_feedback_total)", "legendFormat": "Action: {{action_taken}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["agrikafka", "reliability", "database", "feedback", "evaluation"],
  "timezone": "browser",
  "title": "07 - Reliability & Evaluation Metrics",
