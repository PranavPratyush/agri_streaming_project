# AgriKafka-Agent — Environment Configuration Template
# Copy this file to .env and configure local values.
# NEVER commit .env to version control.

# --- Project Identity & Profile ---
AGRI_ENV=development
AGRI_LOG_LEVEL=INFO

# --- Apache Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_DEV_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLUSTER_BOOTSTRAP_SERVERS=127.0.0.1:9092,127.0.0.1:9093,127.0.0.1:9094
KAFKA_CLIENT_ID=agri-client-local
KAFKA_CONSUMER_GROUP_PREFIX=agri-group

# --- TimescaleDB / PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agrikafka
POSTGRES_USER=agri_admin
POSTGRES_PASSWORD=replace_with_secure_local_password
AGRI_READONLY_USER=agri_readonly
AGRI_READONLY_PASSWORD=replace_with_secure_readonly_password

# --- Chroma Vector Store ---
CHROMA_PERSIST_DIRECTORY=knowledge/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- LLM Providers & Ingest ---
# Primary Hosted Provider (e.g., Gemini 2.0 Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Fallback Local LLM (Ollama - Optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:latest

# --- Notification Channels ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Web & API Endpoints (Strictly bound to 127.0.0.1) ---
BACKEND_API_HOST=127.0.0.1
BACKEND_API_PORT=8000
PWA_DEV_PORT=5173
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# --- Live Telemetry Sources ---
OPENSENSEMAP_API_BASE=https://api.opensensemap.org
# Verified Stage 6 Station ID: Sarvamangalam
OPENSENSEMAP_BOX_ID=689b2bdc569c2d0007586ae9
IMD_API_KEY=replace_if_token_required
